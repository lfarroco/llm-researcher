DATABASE_URL=postgresql://postgres:postgres@db:5432/researcher
APP_ENV=development

# LLM Provider Configuration
# Options: "openai", "ollama", "groq", "deepseek"
LLM_PROVIDER=ollama

# Model name - depends on your provider
# For OpenAI: "gpt-4o", "gpt-4", "gpt-3.5-turbo", etc.
# For Ollama: "qwen3:4b", "llama2", "mistral", etc.
# For Groq: "llama-3.3-70b-versatile", etc.
# For DeepSeek: "deepseek-flash" (V4.1-Flash, current), "deepseek-chat",
#   "deepseek-reasoner". Prefer "deepseek-flash": the V4-era ids
#   "deepseek-v4-flash" and "deepseek-v4-pro" are retired and only route to
#   V4.1-Flash as temporary compatibility aliases.
LLM_MODEL=qwen3:4b

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.2

# Ollama Configuration (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek Configuration (only needed if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional search provider keys
# SPRINGER_API_KEY enables Springer Nature metadata search plugin.
SPRINGER_API_KEY=
# ELSEVIER_API_KEY enables Elsevier Scopus search plugin.
ELSEVIER_API_KEY=

# Research report generation
# Minimum word count the synthesis model is asked to write.
RESEARCH_REPORT_WORD_TARGET=2500
# How many characters of each source's snippet are passed to the synthesis model.
RESEARCH_SYNTHESIS_EXCERPT_CHARS=1200

# Full-text grounding
# When enabled, open-access PDFs are downloaded, parsed (GROBID, falling back
# to local parsers) and chunked, so the report can quote real paper text
# instead of only abstracts and search-result snippets. Retrieval is
# best-effort: sources that cannot be fetched are marked and skipped.
RESEARCH_FULLTEXT_ENABLED=true
# Candidate sources considered for full-text retrieval per research run.
RESEARCH_FULLTEXT_MAX_SOURCES=8
# Chunks kept per source, ranked by relevance to the sub-query.
RESEARCH_FULLTEXT_CHUNKS_PER_SOURCE=3
# Character budget for full-text passages handed to the synthesis model,
# per source. Sits alongside the snippet budget above, not instead of it.
RESEARCH_SYNTHESIS_FULLTEXT_CHARS=6000

# PDF retrieval and parsing
# Cache directory for downloaded PDFs. Uncomment to override; when unset the
# system temp directory is used. (An empty value is treated as unset.)
# PDF_CACHE_DIR=/var/cache/llm-researcher/pdfs
# Refuse to download PDFs larger than this many megabytes.
MAX_PDF_SIZE_MB=50
# GROBID server used for structured academic PDF parsing.
GROBID_SERVER=http://grobid:8070
# Seconds to wait for a GROBID parse before falling back to local parsers.
GROBID_TIMEOUT_SECONDS=30

# LLM output cap
# Explicit max output tokens per LLM response (allows long-form reports).
LLM_MAX_OUTPUT_TOKENS=8192

# DeepSeek thinking mode (chain-of-thought reasoning before answering)
# Enabled by default at the API level too. Effort: low | high | max.
# Note: temperature is ignored while thinking mode is enabled.
LLM_THINKING_ENABLED=true
LLM_THINKING_EFFORT=high
