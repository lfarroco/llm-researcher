DATABASE_URL=postgresql://postgres:postgres@db:5432/researcher
APP_ENV=development

# LLM Provider Configuration
# Options: "openai", "ollama", "groq", "deepseek"
LLM_PROVIDER=ollama

# Model name - depends on your provider
# For OpenAI: "gpt-4o", "gpt-4", "gpt-3.5-turbo", etc.
# For Ollama: "qwen3:4b", "llama2", "mistral", etc.
# For Groq: "llama-3.3-70b-versatile", etc.
# For DeepSeek: "deepseek-v4-flash", "deepseek-v4-pro", "deepseek-chat", "deepseek-reasoner"
LLM_MODEL=qwen3:4b

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.2

# Ollama Configuration (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq Configuration (only needed if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek Configuration (only needed if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional search provider keys
# SPRINGER_API_KEY enables Springer Nature metadata search plugin.
SPRINGER_API_KEY=
# ELSEVIER_API_KEY enables Elsevier Scopus search plugin.
ELSEVIER_API_KEY=

# Research report generation
# Minimum word count the synthesis model is asked to write.
RESEARCH_REPORT_WORD_TARGET=2500
# How many characters of each source's snippet are passed to the synthesis model.
RESEARCH_SYNTHESIS_EXCERPT_CHARS=1200

# LLM output cap
# Explicit max output tokens per LLM response (allows long-form reports).
LLM_MAX_OUTPUT_TOKENS=8192

# DeepSeek thinking mode (chain-of-thought reasoning before answering)
# Enabled by default at the API level too. Effort: low | high | max.
# Note: temperature is ignored while thinking mode is enabled.
LLM_THINKING_ENABLED=true
LLM_THINKING_EFFORT=high
